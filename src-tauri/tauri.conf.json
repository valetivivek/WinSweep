{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinSweep",
  "version": "0.3.0",
  "identifier": "com.winsweep.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WinSweep",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "backgroundColor": "#f5f3f7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "WinSweep",
    "homepage": "https://github.com/valetivivek/WinSweep",
    "category": "Utility",
    "shortDescription": "Manage installed software, keep it updated, and clean up leftover files.",
    "longDescription": "WinSweep is a modern Windows utility for managing installed software, keeping it updated via winget and the Microsoft Store, and cleaning up residual files left behind after uninstalls. Includes scheduled cleanup, app data management, and orphan file categorization.",
    "copyright": "Copyright (c) 2026 WinSweep",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
